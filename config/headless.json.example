{
  "_comment": "RaspyJack Portable Headless Configuration (WiFi CLIENT mode only)",
  "_instructions": "Copy this file to headless.json and fill in your values. Then run the setup script. This system assumes the Pi is a WiFi CLIENT connecting to an existing network (e.g. phone hotspot). It does NOT create its own access point.",

  "wifi": {
    "_comment": "The WiFi network the Pi should connect to as a client.",
    "ssid": "YOUR_WIFI_SSID",
    "password": "YOUR_WIFI_PASSWORD",
    "_interface_comment": "Which WiFi adapter to use for the hotspot connection. 'auto' = prefer USB dongle over onboard (recommended). Use 'wlan0' to force onboard, 'wlan1' to force external dongle. USB dongle works in ANY port.",
    "interface": "auto"
  },

  "hostname": "Raspyjack",

  "network": {
    "_comment": "Network configuration for reliable access to the Pi.",
    "prefer_wifi_over_ethernet": true,

    "_wlan_static_comment": "Give the Pi a fixed IP on your phone hotspot so the WebUI is always reachable at the same address. Leave empty to use DHCP. iPhone hotspot is always 172.20.10.0/24 (gateway 172.20.10.1). Android varies — check your phone. Example: wlan_static_ip = '172.20.10.100'.",
    "wlan_static_ip": "",
    "wlan_gateway": "",

    "_eth_comment": "Flexible Ethernet — eth0 auto-detects what's on the cable. eth_router_mode=true makes eth0 pull DHCP when plugged into a router/switch (Pi gets internet + can scan that LAN). When nothing hands out DHCP (Pi cabled straight to a computer/phone), it falls back to 'shared' mode at eth_static_ip and hands out an IP so you can SSH in — no setup on the other device. Set eth_static_ip empty to disable the direct-connect fallback (pure DHCP client).",
    "eth_router_mode": true,
    "eth_static_ip": "192.168.100.1"
  },

  "tailscale": {
    "_comment": "Optional remote access. Leave enabled=false unless you want Tailscale — it needs internet to come up, so on an internet-less phone hotspot it just logs errors. To use it, set enabled=true and point auth_key_file at a file holding your key (that file is gitignored).",
    "enabled": false,
    "auth_key_file": "/root/Raspyjack/config/.tailscale_auth_key"
  },

  "observed": {
    "_comment": "Fill these in after setup so you remember how to reach your device.",
    "tailscale_ipv4": "",
    "tailscale_magic_dns": "raspyjack.<your-tailnet>.ts.net",
    "mdns_name": "raspyjack.local",
    "direct_connect_ethernet_ip": "192.168.100.1"
  },

  "fan_control": {
    "_comment": "Optional dynamic fan control using a safe GPIO pin.",
    "enabled": false,
    "pin": 18,
    "min_temp_c": 45,
    "max_temp_c": 70,
    "min_duty": 20,
    "max_duty": 100
  },

  "webui": {
    "_comment": "Future: automatic creation of a default WebUI user on first boot (not yet implemented).",
    "create_default_user": false
  }
}
